   "source": [
    "## Mutability\n",
    "- Strings are immutable\n",
    "- Lists are mutable"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8f530362",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 2, 3, 4, 500]\n"
     ]
    }
   ],
   "source": [
    "# Editing with indexing.\n",
    "L = [1,2,3,4,5]\n",
    "L[-1] = 500\n",
    "print(L) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "05c7b9fa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 200, 300, 400, 5]\n"
     ]
    }
   ],
   "source": [
    "# Editing with Slicing.\n",
    "L = [1,2,3,4,5]\n",
    "L[1:4] = [200,300,400]\n",
    "print(L)"
   ]
  }
